# Copy this file to .env, then fill in your private relay credentials.
# .env is git-ignored; do not commit the filled file.
DEEPEVAL_JUDGE_BASE_URL=https://api.deepseek.com/v1
DEEPEVAL_JUDGE_API_KEY=PASTE_YOUR_RELAY_API_KEY_HERE

# Optional model-backed replay config; never reuse DEEPEVAL_JUDGE_* values.
RAG_EVAL_AGENT_BASE_URL=https://agent.example/v1
RAG_EVAL_AGENT_API_KEY=PASTE_YOUR_AGENT_API_KEY_HERE
RAG_EVAL_AGENT_MODEL=PASTE_AGENT_MODEL_NAME_HERE
RAG_EVAL_AGENT_API_FORMAT=openai_chat
RAG_EVAL_AGENT_TEMPERATURE=0
RAG_EVAL_AGENT_PROMPT_VERSION=agent-eval-prompt-v1
