{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run prepare:android",
    "beforeBuildCommand": "npm run prepare:android",
    "frontendDist": "../mobile-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "股选优",
        "url": "index.html",
        "theme": "Dark",
        "backgroundColor": "#120E0D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": ["icons/icon.png"],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 3
    }
  }
}
