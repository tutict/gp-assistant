{
  "name": "stock-optimizer-desktop",
  "private": true,
  "version": "0.4.55",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows": "npm run prepare:windows && tauri build --config src-tauri/tauri.skip-beforebuild.json",
    "android:init": "tauri android init --ci --skip-targets-install",
    "prepare:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-tauri-android-assets.ps1",
    "build:android": "tauri android build --apk --target aarch64 --ci",
    "prepare:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-tauri-android-assets.ps1 -SkipAndroidProjectUpdates",
    "prepare:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-rag-model.ps1 && npm run prepare:desktop"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
