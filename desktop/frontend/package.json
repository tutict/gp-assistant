{
  "name": "gp-assistant-frontend",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "tsc -b && vite build",
    "build": "npm run build:app && npm run test:bundle",
    "preview": "vite preview",
    "test": "npm run test:version && npm run test:industry-export && npm run test:density && npm run test:density-contract && npm run test:agent-replay-css && npm run test:unstyled && npm run test:architecture && npm run test:theme-parity-contract && npm run test:theme-parity && vitest run && npm run build:app && npm run test:contrast:built && npm run test:desktop:built",
    "test:version": "node ../../scripts/check-version-consistency.mjs",
    "test:industry-export": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/export-mobile-industry-snapshot.test.ps1",
    "test:unit": "vitest run",
    "test:density": "node ../../scripts/check-ui-density.mjs",
    "test:density-contract": "node --test ../../scripts/check-ui-density.test.mjs",
    "test:agent-replay-css": "node --test ../../scripts/check-agent-replay-css.test.mjs",
    "test:unstyled": "node ../../scripts/check-unstyled-classes.mjs",
    "test:architecture": "node ../../scripts/check-css-architecture.mjs",
    "test:theme-parity-contract": "node --test ../../scripts/check-theme-parity.test.mjs ../../scripts/ui-contrast-audit.test.mjs",
    "test:theme-parity": "node ../../scripts/check-theme-parity.mjs",
    "test:contrast": "npm run build:app && npm run test:contrast:built",
    "test:contrast:built": "node ../../scripts/ui-contrast-audit.mjs --serve --warn",
    "test:bundle": "node ../../scripts/check-bundle-budget.mjs",
    "test:desktop": "npm run build:app && npm run test:desktop:built",
    "test:desktop:built": "node ../../scripts/ui-screenshot.mjs --serve --check-only --check-search-overlay --check-news-page --check-backtest-page --check-news-interactions",
    "ui:screenshots": "node ../../scripts/ui-screenshot.mjs",
    "ui:backtest": "npm run build:app && node ../../scripts/ui-screenshot.mjs --serve --backtest-page-only --output ./test-baselines --stable-report"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "react-test-renderer": "^19.2.8",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
